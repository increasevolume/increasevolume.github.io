---
import { SUPPORTED_LANGUAGES, TRANSLATIONS, type LangCode } from '../i18n/translations';
import { pwaInfo } from 'virtual:pwa-info';

interface Props {
  lang: LangCode;
}

const { lang } = Astro.props;
const t = TRANSLATIONS[lang];
const currentLangObj = SUPPORTED_LANGUAGES.find((l) => l.code === lang) || SUPPORTED_LANGUAGES[0];
const siteOrigin = 'https://increasevolume.github.io';
const canonicalUrl = `${siteOrigin}${currentLangObj.path}`;
const ogImageUrl = `${siteOrigin}/og-image.svg`;

const jsonLdGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      name: 'IncreaseVolume - Free Online Audio & MP3 Volume Booster',
      url: canonicalUrl,
      description:
        'Increase volume of audio and MP3 files online up to 500% (+14 dB) directly in your browser. 100% client-side Web Audio API processing with smart anti-clipping limiter, real-time waveform preview, and offline PWA support.',
      applicationCategory: 'MultimediaApplication',
      operatingSystem: 'Windows, macOS, iOS, Android, Linux',
      browserRequirements: 'Requires JavaScript and Web Audio API',
      inLanguage: currentLangObj.hreflang,
      offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'USD',
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: t.breadcrumbs.home,
          item: `${siteOrigin}/`,
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: t.breadcrumbs.current,
          item: canonicalUrl,
        },
      ],
    },
    {
      '@type': 'HowTo',
      name: 'How to Increase Audio Volume Online Without Distortion',
      description: t.howTo.sectionSubtitle,
      totalTime: 'PT15S',
      step: [
        {
          '@type': 'HowToStep',
          position: 1,
          name: t.howTo.step1Title,
          text: t.howTo.step1Desc,
          url: `${canonicalUrl}#how-to-step-1`,
        },
        {
          '@type': 'HowToStep',
          position: 2,
          name: t.howTo.step2Title,
          text: t.howTo.step2Desc,
          url: `${canonicalUrl}#how-to-step-2`,
        },
        {
          '@type': 'HowToStep',
          position: 3,
          name: t.howTo.step3Title,
          text: t.howTo.step3Desc,
          url: `${canonicalUrl}#how-to-step-3`,
        },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: t.faq.items.map((item) => ({
        '@type': 'Question',
        name: item.q,
        acceptedAnswer: {
          '@type': 'Answer',
          text: item.a,
        },
      })),
    },
  ],
};
---

<!doctype html>
<html lang={currentLangObj.hreflang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-FGJCVGP26V"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-FGJCVGP26V');
    </script>

    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    <meta name="keywords" content={t.meta.keywords} />
    <meta name="author" content="IncreaseVolume Studio" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="theme-color" content="#202734" />

    <!-- Canonical & Hreflang Cluster (8 Languages + x-default) -->
    <link rel="canonical" href={canonicalUrl} />
    {
      SUPPORTED_LANGUAGES.map((locale) => (
        <link rel="alternate" hreflang={locale.hreflang} href={`${siteOrigin}${locale.path}`} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={`${siteOrigin}/`} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="IncreaseVolume" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={t.meta.title} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={currentLangObj.hreflang.replace('-', '_')} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={t.meta.title} />
    <meta name="twitter:description" content={t.meta.description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Icons & PWA -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    {pwaInfo && <Fragment set:html={pwaInfo.webManifest.linkTag} />}

    <!-- Strict JSON-LD Structured Data (Zero Fake AggregateRating) -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdGraph)} />

    <!-- Theme Initialization (Light Mode Default #F6FBF2, Dark Mode #202734) -->
    <script is:inline>
      (function () {
        try {
          const savedTheme = localStorage.getItem('increasevolume-theme');
          if (savedTheme === 'dark') {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }
        } catch (e) {}
      })();
    </script>

    <style is:global>
      /* Oversized accessible range slider thumb (w-8 h-8 = 32px) */
      input[type='range'].studio-volume-slider {
        -webkit-appearance: none;
        appearance: none;
        height: 16px;
        border-radius: 9999px;
        cursor: pointer;
      }
      input[type='range'].studio-volume-slider:focus {
        outline: 3px solid #B7D894;
        outline-offset: 4px;
      }
      input[type='range'].studio-volume-slider::-webkit-slider-thumb {
        -webkit-appearance: none;
        appearance: none;
        width: 34px;
        height: 34px;
        border-radius: 9999px;
        background: #B7D894;
        border: 4px solid #202734;
        box-shadow: 0 4px 14px rgba(32, 39, 52, 0.35);
        cursor: grab;
        transition: transform 0.2s cubic-bezier(0.22, 1, 0.36, 1), background-color 0.2s ease;
      }
      .dark input[type='range'].studio-volume-slider::-webkit-slider-thumb {
        background: #B7D894;
        border: 4px solid #E0F8C7;
        box-shadow: 0 4px 16px rgba(183, 216, 148, 0.45);
      }
      input[type='range'].studio-volume-slider::-webkit-slider-thumb:hover {
        transform: scale(1.14);
      }
      input[type='range'].studio-volume-slider::-webkit-slider-thumb:active {
        cursor: grabbing;
        transform: scale(1.22);
      }
      input[type='range'].studio-volume-slider::-moz-range-thumb {
        width: 34px;
        height: 34px;
        border-radius: 9999px;
        background: #B7D894;
        border: 4px solid #202734;
        box-shadow: 0 4px 14px rgba(32, 39, 52, 0.35);
        cursor: grab;
        transition: transform 0.2s cubic-bezier(0.22, 1, 0.36, 1), background-color 0.2s ease;
      }
      .dark input[type='range'].studio-volume-slider::-moz-range-thumb {
        background: #B7D894;
        border: 4px solid #E0F8C7;
      }

      /* Smooth breathing animation for oversized dropzone icon */
      @keyframes studioBreath {
        0%, 100% {
          transform: scale(1) translateY(0);
        }
        50% {
          transform: scale(1.06) translateY(-4px);
        }
      }
      .animate-studio-breath {
        animation: studioBreath 3.2s cubic-bezier(0.22, 1, 0.36, 1) infinite;
      }

      /* Animated equalizer bars in Navbar logo */
      @keyframes eqBar1 {
        0%, 100% { height: 10px; }
        50% { height: 22px; }
      }
      @keyframes eqBar2 {
        0%, 100% { height: 22px; }
        50% { height: 12px; }
      }
      @keyframes eqBar3 {
        0%, 100% { height: 14px; }
        50% { height: 24px; }
      }
      .eq-bar-1 { animation: eqBar1 1.1s ease-in-out infinite; }
      .eq-bar-2 { animation: eqBar2 0.85s ease-in-out infinite; }
      .eq-bar-3 { animation: eqBar3 1.25s ease-in-out infinite; }
    </style>
  </head>
  <body
    class="min-h-screen flex flex-col bg-mint-alabaster text-midnight-navy dark:bg-midnight-navy dark:text-mint-cream font-sans antialiased selection:bg-sage-lime selection:text-midnight-navy transition-colors duration-300"
  >
    <slot />
    <script>
      import { registerSW } from 'virtual:pwa-register';
      if (import.meta.env.PROD) {
        registerSW({ immediate: true });
      } else if ('serviceWorker' in navigator) {
        navigator.serviceWorker.getRegistrations().then((regs) => {
          for (const reg of regs) reg.unregister();
        });
      }
    </script>
  </body>
</html>
