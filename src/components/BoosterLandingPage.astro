---
import Layout from '../layouts/Layout.astro';
import Navbar from './Navbar.astro';
import AudioBoosterIsland from './AudioBoosterIsland';
import { SUPPORTED_LANGUAGES, TRANSLATIONS, type LangCode } from '../i18n/translations';

interface Props {
  lang: LangCode;
}

const { lang } = Astro.props;
const t = TRANSLATIONS[lang];
const currentLang = SUPPORTED_LANGUAGES.find((l) => l.code === lang) || SUPPORTED_LANGUAGES[0];
---

<Layout lang={lang}>
  <Navbar lang={lang} />

  <main id="main-content" class="flex-1">
    <!-- Visible Semantic Breadcrumb Navigation (paired with BreadcrumbList JSON-LD) -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6">
      <nav aria-label="Breadcrumb" class="inline-flex items-center gap-2 text-base font-bold text-slate-navy dark:text-mint-cream/80">
        <ol class="inline-flex items-center gap-2">
          <li>
            <a
              href="/"
              class="hover:text-midnight-navy dark:hover:text-sage-lime underline decoration-sage-lime decoration-2 underline-offset-4 transition-colors"
            >
              {t.breadcrumbs.home}
            </a>
          </li>
          <li aria-hidden="true" class="opacity-60">/</li>
          <li aria-current="page" class="text-midnight-navy dark:text-sage-lime font-extrabold">
            {t.breadcrumbs.current}
          </li>
        </ol>
      </nav>
    </div>

    <!-- Hero & Interactive Audio Volume Booster Studio Section -->
    <section
      aria-labelledby="hero-heading"
      class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6 pb-16 md:pt-10 md:pb-24"
    >
      <div class="text-center max-w-4xl mx-auto mb-10 md:mb-12">
        <h1
          id="hero-heading"
          class="text-4xl md:text-6xl font-extrabold tracking-tight text-midnight-navy dark:text-mint-cream leading-[1.1] mb-5"
        >
          {t.hero.h1}
        </h1>

        <p class="text-lg md:text-xl font-medium text-slate-navy dark:text-mint-cream/90 leading-relaxed max-w-3xl mx-auto">
          {t.hero.subtitle}
        </p>
      </div>

      <!-- React Island: 100% Client-Side Web Audio API Booster -->
      <AudioBoosterIsland client:load dropzone={t.dropzone} studio={t.studio} />
    </section>

    <!-- Section 1: How to Increase Audio Volume Online in 3 Steps -->
    <section
      id="how-to-increase-audio-volume"
      aria-labelledby="howto-heading"
      class="py-16 md:py-24 border-t-2 border-midnight-navy/10 dark:border-mint-cream/10 bg-mint-cream/45 dark:bg-slate-navy/40"
    >
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto mb-12 md:mb-16">
          <h2
            id="howto-heading"
            class="text-2xl md:text-3xl font-bold text-midnight-navy dark:text-mint-cream mb-4"
          >
            {t.howTo.sectionTitle}
          </h2>
          <p class="text-lg md:text-xl font-medium text-slate-navy dark:text-mint-cream/85">
            {t.howTo.sectionSubtitle}
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8">
          <article
            id="how-to-step-1"
            class="rounded-3xl bg-white dark:bg-slate-navy border-2 border-midnight-navy/15 dark:border-sage-lime/30 p-7 md:p-8 shadow-lg flex flex-col justify-between"
          >
            <div>
              <div
                class="w-14 h-14 rounded-2xl bg-midnight-navy dark:bg-sage-lime text-mint-cream dark:text-midnight-navy font-black text-2xl flex items-center justify-center mb-6 shadow-md"
                aria-hidden="true"
              >
                01
              </div>
              <h3 class="text-xl md:text-2xl font-extrabold text-midnight-navy dark:text-mint-cream mb-3">
                {t.howTo.step1Title}
              </h3>
              <p class="text-lg md:text-xl font-medium text-slate-navy dark:text-mint-cream/85 leading-relaxed">
                {t.howTo.step1Desc}
              </p>
            </div>
          </article>

          <article
            id="how-to-step-2"
            class="rounded-3xl bg-white dark:bg-slate-navy border-2 border-midnight-navy/15 dark:border-sage-lime/30 p-7 md:p-8 shadow-lg flex flex-col justify-between"
          >
            <div>
              <div
                class="w-14 h-14 rounded-2xl bg-midnight-navy dark:bg-sage-lime text-mint-cream dark:text-midnight-navy font-black text-2xl flex items-center justify-center mb-6 shadow-md"
                aria-hidden="true"
              >
                02
              </div>
              <h3 class="text-xl md:text-2xl font-extrabold text-midnight-navy dark:text-mint-cream mb-3">
                {t.howTo.step2Title}
              </h3>
              <p class="text-lg md:text-xl font-medium text-slate-navy dark:text-mint-cream/85 leading-relaxed">
                {t.howTo.step2Desc}
              </p>
            </div>
          </article>

          <article
            id="how-to-step-3"
            class="rounded-3xl bg-white dark:bg-slate-navy border-2 border-midnight-navy/15 dark:border-sage-lime/30 p-7 md:p-8 shadow-lg flex flex-col justify-between"
          >
            <div>
              <div
                class="w-14 h-14 rounded-2xl bg-midnight-navy dark:bg-sage-lime text-mint-cream dark:text-midnight-navy font-black text-2xl flex items-center justify-center mb-6 shadow-md"
                aria-hidden="true"
              >
                03
              </div>
              <h3 class="text-xl md:text-2xl font-extrabold text-midnight-navy dark:text-mint-cream mb-3">
                {t.howTo.step3Title}
              </h3>
              <p class="text-lg md:text-xl font-medium text-slate-navy dark:text-mint-cream/85 leading-relaxed">
                {t.howTo.step3Desc}
              </p>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- Section 2: Increase MP3 Volume Without Distortion (Smart Peak Limiter) -->
    <section
      id="smart-peak-limiter"
      aria-labelledby="limiter-heading"
      class="py-16 md:py-24 border-t-2 border-midnight-navy/10 dark:border-mint-cream/10"
    >
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
          <div class="lg:col-span-7 space-y-6">
            <h2
              id="limiter-heading"
              class="text-2xl md:text-3xl font-bold text-midnight-navy dark:text-mint-cream"
            >
              {t.features.limiterHeading}
            </h2>
            <p class="text-lg md:text-xl font-medium text-slate-navy dark:text-mint-cream/90 leading-relaxed">
              {t.features.limiterParagraph1}
            </p>
            <p class="text-lg md:text-xl font-medium text-slate-navy dark:text-mint-cream/90 leading-relaxed">
              {t.features.limiterParagraph2}
            </p>
            <ul class="space-y-4 pt-2">
              <li class="flex items-start gap-3.5 text-lg md:text-xl font-bold text-midnight-navy dark:text-mint-cream">
                <span class="w-7 h-7 rounded-lg bg-sage-lime text-midnight-navy flex items-center justify-center font-black shrink-0 mt-0.5">
                  ✓
                </span>
                <span>{t.features.limiterBullet1}</span>
              </li>
              <li class="flex items-start gap-3.5 text-lg md:text-xl font-bold text-midnight-navy dark:text-mint-cream">
                <span class="w-7 h-7 rounded-lg bg-sage-lime text-midnight-navy flex items-center justify-center font-black shrink-0 mt-0.5">
                  ✓
                </span>
                <span>{t.features.limiterBullet2}</span>
              </li>
              <li class="flex items-start gap-3.5 text-lg md:text-xl font-bold text-midnight-navy dark:text-mint-cream">
                <span class="w-7 h-7 rounded-lg bg-sage-lime text-midnight-navy flex items-center justify-center font-black shrink-0 mt-0.5">
                  ✓
                </span>
                <span>{t.features.limiterBullet3}</span>
              </li>
            </ul>
          </div>

          <!-- Studio Gain & Decibel Reference Card -->
          <div class="lg:col-span-5 rounded-3xl bg-midnight-navy dark:bg-slate-navy border-2 border-sage-lime p-7 md:p-8 text-mint-cream shadow-2xl">
            <h3 class="text-xl md:text-2xl font-extrabold text-sage-lime mb-4">
              Web Audio Gain &amp; Decibel Reference
            </h3>
            <div class="space-y-3 font-mono text-base md:text-lg">
              <div class="flex items-center justify-between p-3.5 rounded-2xl bg-slate-navy/70 dark:bg-midnight-navy/70">
                <span class="font-bold">100% Baseline</span>
                <span class="text-mint-cream font-black">0.0 dB (Unity)</span>
              </div>
              <div class="flex items-center justify-between p-3.5 rounded-2xl bg-slate-navy/70 dark:bg-midnight-navy/70">
                <span class="font-bold">150% Gentle</span>
                <span class="text-sage-lime font-black">+3.5 dB</span>
              </div>
              <div class="flex items-center justify-between p-3.5 rounded-2xl bg-slate-navy/70 dark:bg-midnight-navy/70 border border-sage-lime/50">
                <span class="font-bold">200% Double</span>
                <span class="text-sage-lime font-black">+6.0 dB</span>
              </div>
              <div class="flex items-center justify-between p-3.5 rounded-2xl bg-slate-navy/70 dark:bg-midnight-navy/70">
                <span class="font-bold">300% Voice</span>
                <span class="text-sage-lime font-black">+9.5 dB</span>
              </div>
              <div class="flex items-center justify-between p-3.5 rounded-2xl bg-sage-lime text-midnight-navy font-black">
                <span>500% Max Rescue</span>
                <span>+14.0 dB</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Section 3: 100% Client-Side Privacy: Why Local Web Audio Processing Matters -->
    <section
      id="client-side-privacy"
      aria-labelledby="privacy-heading"
      class="py-16 md:py-24 border-t-2 border-midnight-navy/10 dark:border-mint-cream/10 bg-mint-cream/45 dark:bg-slate-navy/40"
    >
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-4xl mx-auto text-center space-y-6 mb-12">
          <h2
            id="privacy-heading"
            class="text-2xl md:text-3xl font-bold text-midnight-navy dark:text-mint-cream"
          >
            {t.features.privacyHeading}
          </h2>
          <p class="text-lg md:text-xl font-medium text-slate-navy dark:text-mint-cream/90 leading-relaxed">
            {t.features.privacyParagraph1}
          </p>
          <p class="text-lg md:text-xl font-medium text-slate-navy dark:text-mint-cream/90 leading-relaxed">
            {t.features.privacyParagraph2}
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="rounded-3xl bg-white dark:bg-slate-navy border-2 border-midnight-navy/15 dark:border-sage-lime/30 p-7 text-center shadow-md">
            <div class="text-3xl md:text-4xl font-black text-midnight-navy dark:text-sage-lime mb-2">
              {t.features.privacyStat1Value}
            </div>
            <div class="text-lg md:text-xl font-bold text-slate-navy dark:text-mint-cream">
              {t.features.privacyStat1Label}
            </div>
          </div>
          <div class="rounded-3xl bg-white dark:bg-slate-navy border-2 border-midnight-navy/15 dark:border-sage-lime/30 p-7 text-center shadow-md">
            <div class="text-3xl md:text-4xl font-black text-midnight-navy dark:text-sage-lime mb-2">
              {t.features.privacyStat2Value}
            </div>
            <div class="text-lg md:text-xl font-bold text-slate-navy dark:text-mint-cream">
              {t.features.privacyStat2Label}
            </div>
          </div>
          <div class="rounded-3xl bg-white dark:bg-slate-navy border-2 border-midnight-navy/15 dark:border-sage-lime/30 p-7 text-center shadow-md">
            <div class="text-3xl md:text-4xl font-black text-midnight-navy dark:text-sage-lime mb-2">
              {t.features.privacyStat3Value}
            </div>
            <div class="text-lg md:text-xl font-bold text-slate-navy dark:text-mint-cream">
              {t.features.privacyStat3Label}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Section 4: Interactive FAQ Section -->
    <section
      id="faq"
      aria-labelledby="faq-heading"
      class="py-16 md:py-24 border-t-2 border-midnight-navy/10 dark:border-mint-cream/10"
    >
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2
            id="faq-heading"
            class="text-2xl md:text-3xl font-bold text-midnight-navy dark:text-mint-cream mb-4"
          >
            {t.faq.title}
          </h2>
          <p class="text-lg md:text-xl font-medium text-slate-navy dark:text-mint-cream/85">
            {t.faq.subtitle}
          </p>
        </div>

        <div class="space-y-4">
          {
            t.faq.items.map((item, idx) => (
              <details
                open={idx === 0}
                class="group rounded-3xl bg-white dark:bg-slate-navy border-2 border-midnight-navy/15 dark:border-mint-cream/20 open:border-midnight-navy dark:open:border-sage-lime p-6 md:p-7 shadow-md transition-all"
              >
                <summary class="flex items-center justify-between gap-4 cursor-pointer list-none focus:outline-none">
                  <h3 class="text-xl md:text-2xl font-extrabold text-midnight-navy dark:text-mint-cream">
                    {item.q}
                  </h3>
                  <span
                    aria-hidden="true"
                    class="w-10 h-10 rounded-xl bg-mint-cream dark:bg-midnight-navy text-midnight-navy dark:text-sage-lime flex items-center justify-center font-black text-xl shrink-0 group-open:rotate-45 transition-transform"
                  >
                    +
                  </span>
                </summary>
                <p class="mt-4 pt-4 border-t border-midnight-navy/10 dark:border-mint-cream/10 text-lg md:text-xl font-medium text-slate-navy dark:text-mint-cream/90 leading-relaxed">
                  {item.a}
                </p>
              </details>
            ))
          }
        </div>
      </div>
    </section>
  </main>

  <!-- Semantic Footer -->
  <footer class="border-t-2 border-midnight-navy/15 dark:border-mint-cream/15 bg-midnight-navy text-mint-cream py-12 md:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-10 pb-10 border-b border-mint-cream/15">
        <div class="md:col-span-5 space-y-4">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-sage-lime flex items-end justify-center gap-1 pb-2 px-2">
              <span class="w-1.5 h-3 bg-midnight-navy rounded-full"></span>
              <span class="w-1.5 h-5 bg-midnight-navy rounded-full"></span>
              <span class="w-1.5 h-4 bg-midnight-navy rounded-full"></span>
            </div>
            <span class="text-2xl font-extrabold tracking-tight text-mint-cream">
              {t.nav.brand}
            </span>
          </div>
          <p class="text-base md:text-lg text-mint-cream/80 leading-relaxed max-w-md">
            {t.footer.description}
          </p>
          <div class="pt-2">
            <a
              href="https://ko-fi.com/kishara"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2.5 px-6 py-3.5 rounded-2xl bg-sage-lime text-midnight-navy font-extrabold text-base md:text-lg hover:scale-[1.02] transition-transform"
            >
              <span>♥</span>
              <span>{t.footer.supportCta}</span>
            </a>
          </div>
        </div>

        <div class="md:col-span-3 space-y-3">
          <h2 class="text-lg font-extrabold text-sage-lime uppercase tracking-wider">
            {t.footer.QuickLinks}
          </h2>
          <ul class="space-y-2.5 text-base md:text-lg font-semibold">
            <li>
              <a href="#main-content" class="hover:text-sage-lime transition-colors">
                {t.hero.h1}
              </a>
            </li>
            <li>
              <a href="#how-to-increase-audio-volume" class="hover:text-sage-lime transition-colors">
                {t.howTo.sectionTitle}
              </a>
            </li>
            <li>
              <a href="#smart-peak-limiter" class="hover:text-sage-lime transition-colors">
                Smart Anti-Clipping Limiter
              </a>
            </li>
            <li>
              <a href="#faq" class="hover:text-sage-lime transition-colors">
                FAQ
              </a>
            </li>
          </ul>
        </div>

        <div class="md:col-span-4 space-y-3">
          <h2 class="text-lg font-extrabold text-sage-lime uppercase tracking-wider">
            {t.footer.languagesHeading}
          </h2>
          <div class="grid grid-cols-2 gap-2.5">
            {
              SUPPORTED_LANGUAGES.map((locale) => (
                <a
                  href={locale.path}
                  class:list={[
                    'px-3.5 py-2 rounded-xl text-sm font-bold flex items-center gap-2 transition-colors',
                    locale.code === currentLang.code
                      ? 'bg-sage-lime text-midnight-navy font-extrabold'
                      : 'bg-slate-navy/60 text-mint-cream hover:bg-slate-navy',
                  ]}
                >
                  <span class="text-xs font-black opacity-80">{locale.badge}</span>
                  <span>{locale.label}</span>
                </a>
              ))
            }
          </div>
        </div>
      </div>

      <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-sm md:text-base font-medium text-mint-cream/75">
        <p>{t.footer.copyright}</p>
        <p>{t.footer.builtWith}</p>
      </div>
    </div>
  </footer>
</Layout>
